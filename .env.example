# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (server-side only — ماشي public)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
NEXT_PUBLIC_PAYPAL_PLAN_ID=P-XXXXXXXX

# PayZone (اختياري)
PAYZONE_ORIGINATOR_ID=your-originator-id
PAYZONE_PASSWORD=your-payzone-password

# Site
NEXT_PUBLIC_SITE_URL=https://www.moliosempire.com
